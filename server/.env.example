# Copy this file to `.env` (same folder) and fill in the values. `.env` is gitignored — never commit it.

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:4200
# How many reverse proxies sit in front of this server (Render = 1, local dev = 0 or 1).
# Rate limiting uses the client IP, so a wrong value either blocks everyone together
# (too low) or lets people dodge limits by faking headers (too high).
TRUST_PROXY=1

# Supabase: dashboard -> Project Settings -> API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The "service_role" secret key. Server-side only: it bypasses Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=

# Any long random string (e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Cloudinary: console.cloudinary.com -> Settings -> API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
